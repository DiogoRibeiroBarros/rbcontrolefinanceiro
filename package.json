{
  "name": "rb-gestao-financeira-windows",
  "version": "2.4.3",
  "description": "RB Gestão Financeira para Windows",
  "main": "electron-main.cjs",
  "author": "RB Gestão",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/app.test.js && node tests/banking-core.test.js && electron tests/login-session-smoke.cjs && electron tests/biometric-auto-smoke.cjs && electron tests/all-module-reports-smoke.cjs && electron tests/banking-ui-smoke.cjs && electron tests/home-expenses-smoke.cjs && electron tests/investments-ui-smoke.cjs && electron tests/icon-platform-smoke.cjs",
    "build": "npm run build:installers",
    "prepare:release": "node -e \"const fs=require('fs'),p=require('./package.json'),f='app/app.js',s=fs.readFileSync(f,'utf8'),d=new Date().toLocaleString('pt-BR',{dateStyle:'short',timeStyle:'short'});fs.writeFileSync(f,s.replace('__BUILD_DATE__',d));fs.mkdirSync('release/release-'+p.version,{recursive:true})\"",
    "build:full": "electron-builder --win nsis --publish never --config.nsis.include=build/installer.nsh --config.win.artifactName=release-${version}/rb-gestao-financeira-windows-setup-${version}.${ext}",
    "build:update": "electron-builder --win nsis --publish never --config.nsis.include=build/installer-update.nsh --config.win.artifactName=release-${version}/RB_Gestao_Financeira_Atualizacao_${version}.${ext}",
    "build:installers": "npm test && npm run prepare:release && npm run build:full && node -e \"require('fs').copyFileSync('release/latest.yml','release/latest-full.yml')\" && npm run build:update && node -e \"require('fs').copyFileSync('release/latest-full.yml','release/latest.yml')\""
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "br.com.rbgestao.financeira",
    "productName": "RB Gestão Financeira",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.cjs",
      "app/**/*",
      "!app/legacy-data.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/setup-tailscale.ps1",
        "to": "setup-tailscale.ps1"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "app/assets/rb_gestao.ico",
      "artifactName": "RB_Gestao_Financeira_Full_${version}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RB Gestão Financeira",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "PandaRaivoso",
      "repo": "rbcontrolefinanceiro",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "simple-icons": "^16.28.0"
  }
}
